# ============================================================
# .env.example — Environment Variables Template
# ============================================================
# 🔐 3-Layer Secret Architecture
#
# This file is COMMITTED to git as a reference template.
# Your actual secrets live in ~/.env (gitignored, chmod 600).
#
# Quick Start (new machine):
#   vault unlock    — decrypt secrets from core/.env.enc
#   vault status    — check all secrets are set
#   vault init      — interactive wizard to fill in secrets
#
# Adding New Secrets:
#   1. Add key here with empty value
#   2. Set value in ~/.env
#   3. vault lock → git commit → git push
#
# Non-interactive (CI/scripts):
#   export SSOT_VAULT_PASS='<pass>'
#   vault unlock
# ============================================================

# ── 1. Search APIs ──
export BRAVE_SEARCH_API_KEY=""
export BRAVE_API_KEY=""

# ── 2. Syncthing API Keys (Per-device cluster) ──
export NODE_OPPO_ST_KEY=""
export NODE_TERMUX_ST_KEY=""
export NODE_WSL_ST_KEY=""
export NODE_WIN_ST_KEY=""
export NODE_MUMU_ST_KEY=""

# ── 3. Wallets / Personal Information ──
export USDT_BEP20_BITKUB=""
export SOL_BITKUB=""
export SOL_METAMAS=""
export BTC_BITKUB=""
export HOME_ADDRESS=""

# ── 4. Social / Pages ──
export FACEBOOK_PAGE_TOKEN=""
export FACEBOOK_PAGE_ID=""
export SHOPEE_PAGE_TOKEN=""
export SHOPEE_PAGE_ID=""

# ── 5. OpenCode / AI Provider Keys ──
export OC_KEY_MOM=""
export OC_KEY_JOE=""
export OC_KEY_ZEN=""