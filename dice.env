# [Wager Mode]
WAGER_BET=5
WAGER_WIN_CHANCE=98
WAGER_TARGET=1000000.0
WAGER_STOP_ON_WIN=50000

# [Hybrid Mode Triggers]
LOSS_TRIGGER=2.0
PROFIT_TRIGGER=1.0

# ============================================================
# [Custom Strategy Engine (Mode 4)]
# ============================================================
# Base Configuration
