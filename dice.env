# ============================================================
# DICE SIMULATOR - SSOT CONFIGURATION (dice.env)
# Shared between roll2.sh (Bash) & roll.py (Python)
# ============================================================

# [General Settings]
GAME_MODE=4
START_BALANCE=10000
HE=1.0
MAX_ROUNDS=200000
BET_STRATEGY=high
STOP_PROFIT_TARGET=20000
STOP_LOSS_TARGET=10000

# [Profit Mode (Martingale)]
