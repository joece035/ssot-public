#!/bin/bash
# ============================================================
# .bash_checker — SSOT guard dispatcher (script-safe)
# ============================================================
# Usage:
#   _check_ -o -f <path> [cmd args...]  → test object, then run cmd (default: source)
#   _check_ -s [bash|zsh]               → guard current shell (no arg = print shell)
#   _check_ -s -d "<zsh_cmd>" "<bash_cmd>" → run cmd for active shell
#   _check_ -j [--set|--force]          → ensure JOE_ENV (echo / export)
#   _check_ -f <func> [search_dir]      → ensure function loaded (non-interactive safe)
#   _check_ -p [-c] <pkg> [bin] [overrides] → ensure package installed
#   _check_ -h|--help                   → help
#
# Contract: messages → stderr only, 0 = pass, non-zero = fail.
# Safe for:  _check_ -f foo || exit 1
#            _check_ -p -c rg || return 1
# ============================================================

# -- fallback: function-loaded test (canonical lives in personal/find_stuff.sh) --
if ! typeset -f _is_func_loaded >/dev/null 2>&1; then
_is_func_loaded() {
    local func_name="${1:-}"
    [[ -n "$func_name" ]] || return 1
    if [[ -n "${ZSH_VERSION:-}" ]]; then
        typeset -f "$func_name" >/dev/null 2>&1
    else
        declare -F "$func_name" >/dev/null 2>&1
    fi
}
fi

# -- fallback: shell guard (canonical cshell lives in .bash_helper) --
if ! typeset -f _check_shell >/dev/null 2>&1; then
_check_shell() {
    local active="${_SHELL:-}"
    if [[ -z "$active" ]]; then
        if [[ -n "${ZSH_VERSION:-}" ]]; then active="zsh"; else active="bash"; fi
    fi
    # no arg → print active shell (stdout, for capture)
    if [[ $# -eq 0 ]]; then echo "$active"; return 0; fi
    # -d|--detect passthrough (cshell-compatible)
    if [[ "${1:-}" == "-d" || "${1:-}" == "--detect" ]]; then
        shift
        if [[ "$active" == "zsh" ]]; then eval "${1:-}"; else eval "${2:-}"; fi
        return $?
    fi
    # guard mode: _check_shell bash → 0 if match, 1 otherwise
    if [[ "$active" == "${1:-}" ]]; then return 0; fi
    echo "[_check_ -s] shell mismatch: current='$active' required='${1:-}'" >&2
    return 1
}
fi

# -- lazy pkg guard (pkg_manager lives in functions/pkg_manager.sh) --
_check_pkg() {
    if ! typeset -f pkg_manager >/dev/null 2>&1; then
        local _mgr="${SSOT:-$HOME/ssot}/functions/pkg_manager.sh"
        if [[ -f "$_mgr" ]]; then
            # shellcheck disable=SC1090
            source "$_mgr" 2>/dev/null
        fi
    fi
    if ! typeset -f pkg_manager >/dev/null 2>&1; then
        echo "[_check_ -p] pkg_manager unavailable (missing functions/pkg_manager.sh)" >&2
        return 127
    fi
    pkg_manager "$@"
}

# -- script-safe function guard: never prompt (no fzf/select in scripts) --
_check_one_func() {
    local func="${1:-}"
    local context="${2:-${SSOT:-${repository:-$HOME/ssot}}}"
    if [[ -z "$func" ]]; then return 1; fi
    if _is_func_loaded "$func"; then return 0; fi

    # prefer canonical auto-loader when interactive
    if [[ -t 0 ]] && typeset -f auto_source >/dev/null 2>&1; then
        auto_source "$func" "$context"
        return $?
    fi

    # non-interactive: single-match auto-source only, multi-match = fail (no picker)
    # pure-bash: no grep/find — uses globstar (bash 4+) + [[ =~ ]] builtin regex
    if [[ -n "$context" && -d "$context" ]]; then
        local -a _matches=()
        local _f _line _og_null _og_glob
        _og_null=$(shopt -p nullglob 2>/dev/null)
        _og_glob=$(shopt -p globstar 2>/dev/null)
        shopt -s nullglob globstar 2>/dev/null
        local _pat="^[[:space:]]*(function[[:space:]]+${func}([[:space:]\(]|$)|${func}[[:space:]]*\(\))"
        for _f in "$context"/**/*.sh "$context"/**/*.bash "$context"/**/*.zsh; do
            [[ -f "$_f" ]] || continue
            while IFS= read -r _line; do
                if [[ "$_line" =~ $_pat ]]; then _matches+=("$_f"); break; fi
            done < "$_f"
        done
        eval "$_og_null" 2>/dev/null
        eval "$_og_glob" 2>/dev/null
        if [[ ${#_matches[@]} -eq 1 ]]; then
            # shellcheck disable=SC1090
            source "${_matches[1]:-${_matches[0]}}" 2>/dev/null && _is_func_loaded "$func" && return 0
        elif [[ ${#_matches[@]} -gt 1 ]]; then
            echo "[_check_ -f] '$func' ambiguous (${#_matches[@]} files, refusing interactive pick in script):" >&2
            printf '  - %s\n' "${_matches[@]}" >&2
            return 1
        fi
    fi

    # last resort: canonical path (may still prompt only when interactive)
    if typeset -f _check_func >/dev/null 2>&1 && [[ -t 0 ]]; then
        _check_func "$func" "$context"
        return $?
    fi

    echo "[_check_ -f] '$func' not loaded, cannot auto-source non-interactively" >&2
    return 1
}
_check_func_safe() {
    if [[ $# -eq 0 ]]; then
        echo "[_check_ -f] no function name provided" >&2
        return 1
    fi

    local context=""
    # 1. Parse optional -d / --dir flag
    if [[ "${1:-}" == "-d" || "${1:-}" == "--dir" ]]; then
        context="${2:-}"
        shift 2 || true
    fi

    # 2. Detect context directory if passed as last argument
    if [[ -z "$context" && $# -ge 2 && -d "${!#}" ]]; then
        local _last="${!#}"
        local _is_arr=0
        if [[ -n "$ZSH_VERSION" ]]; then
            [[ "${(tP)_last}" == *array* || "${(tP)_last}" == *association* ]] && _is_arr=1
        else
            [[ "$(declare -p "$_last" 2>/dev/null)" =~ ^declare\ -[aA] ]] && _is_arr=1
        fi
        if [[ $_is_arr -eq 0 ]] && ! _is_func_loaded "$_last"; then
            context="$_last"
            set -- "${@:1:$#-1}"
        fi
    fi
    context="${context:-${SSOT:-${repository:-$HOME/ssot}}}"

    # 3. Collect target functions (support array variable name by reference or multiple positional args)
    local -a _target_funcs=()
    local item
    for item in "$@"; do
        [[ -z "$item" ]] && continue
        if [[ -n "$ZSH_VERSION" ]]; then
            if [[ "${(tP)item}" == *array* || "${(tP)item}" == *association* ]]; then
                _target_funcs+=("${(@P)item}")
                continue
            fi
        else
            if [[ "$(declare -p "$item" 2>/dev/null)" =~ ^declare\ -[aA] ]]; then
                local -n _arr_ref="$item"
                _target_funcs+=("${_arr_ref[@]}")
                continue
            fi
        fi
        _target_funcs+=("$item")
    done

    if [[ ${#_target_funcs[@]} -eq 0 ]]; then
        echo "[_check_ -f] no function name provided" >&2
        return 1
    fi

    local func
    local overall_rc=0
    for func in "${_target_funcs[@]}"; do
        [[ -z "$func" ]] && continue
        if _is_func_loaded "$func"; then
            continue
        fi
        if ! _check_one_func "$func" "$context"; then
            overall_rc=1
        fi
    done

    return $overall_rc
}

_check_usage() {
    # printf is a bash builtin — zero external dependency
    printf >&2 '%s\n' \
        'usage: _check_ <mode> [args...]' \
        '  -o|--object  -f <path> [cmd...]   test object then run cmd (default: source)' \
        '  -s|--shell   [bash|zsh]           guard shell (no arg prints current shell)' \
        '  -j|--JENV    [--set|--force]      ensure JOE_ENV' \
        '  -f|--FUNCTION <func|array>... [-d dir] ensure function(s) loaded' \
        '  -p|--PKG     [-c] <pkg> [bin] ... ensure package installed' \
        '  -h|--help                         this help'
}

_check_(){
    # no-arg guard (shift without guard would error under set -e)
    if [[ $# -eq 0 ]]; then _check_usage; return 1; fi

    local mode="${1:-}"
    shift || true

    # -- main
    case "$mode" in
        -o|--object)
            if ! typeset -f _check >/dev/null 2>&1; then
                echo "[_check_ -o] _check unavailable (source .bash_helper first)" >&2
                return 127
            fi
            _check "$@"
            ;;
        -s|--shell)     _check_shell "$@" ;;
        -j|--JENV)
            if ! typeset -f _check_JOE_ENV >/dev/null 2>&1; then
                echo "[_check_ -j] _check_JOE_ENV unavailable (source .bash_helper first)" >&2
                return 127
            fi
            _check_JOE_ENV "$@"
            ;;
        -f|--FUNCTION)  _check_func_safe "$@" ;;
        -p|--PKG)       _check_pkg "$@" ;;
        -h|--help|help) _check_usage; return 0 ;;
        *) _check_usage; return 1 ;;
    esac
}

_C(){
	_check_ "$@"
}
