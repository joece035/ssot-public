#!/bin/bash
# -- source color module which is live isolated from joe.sh
if ! command -v _color_render >/dev/null 2>&1; then
    if [ -f "$HOME/ssot/core/01-colors.sh" ]; then
        source "$HOME/ssot/core/01-colors.sh" 2>/dev/null
    fi
fi
# ==========================================
# 1. นิยามฟังก์ชัน _check() (เวอร์ชัน Cross-Shell)
# ==========================================
_check() {
    local type="${1:--f}"
    local tar_input="${2:-}"
    local cmd="${3:-source}"
    local item=""
    shift 3

    if [ -n "$ZSH_VERSION" ]; then
        if [[ "${(tP)tar_input}" == *array* || "${(tP)tar_input}" == *association* ]]; then
            setopt LOCAL_OPTIONS
            unsetopt KSH_ARRAYS 2>/dev/null
            for item in "${(@P)tar_input}"; do
                test "$type" "$item" && "$cmd" "$item" "$@"
            done
            return 0
        fi
    else
        if [[ "$(declare -p "$tar_input" 2>/dev/null)" =~ ^declare\ -[aA] ]]; then
            local -n ref="$tar_input"
            for item in "${ref[@]}"; do
                test "$type" "$item" && "$cmd" "$item" "$@"
            done
            return 0
        fi
    fi

    test "$type" "$tar_input" && "$cmd" "$tar_input" "$@"
}
#-- helper for  functin, alias unbinding
unbinding(){
    local mode=""
    local target=""

    # parse flags
    while [[ "${1:-}" == -* ]]; do
        case "$1" in
            -a|-f|-af) mode="${1#-}"; shift ;;
            *) break ;;
        esac
    done
    target="${1:-}"
    [ -z "$target" ] && return 0

    # ตรวจ binding type ตาม shell
    local has_alias=0 has_func=0
    case "$JOE_ENV" in
        TERMUX|MUMU)
            local wt
            wt=$(whence -w "$target" 2>/dev/null | cut -d" " -f2)
            [ "$wt" = "alias" ]    && has_alias=1
            [ "$wt" = "function" ] && has_func=1
            ;;
        WSL|GIT-BASH)
            local tt
            tt=$(type -t "$target" 2>/dev/null)
            [ "$tt" = "alias" ]    && has_alias=1
            [ "$tt" = "function" ] && has_func=1
            ;;
        *)
            c 198 b "unknown JOE_ENV: $JOE_ENV"; return 1
            ;;
    esac

    # ลบตาม mode
    local removed=0
    case "$mode" in
        a)
            if (( has_alias )); then
                unalias "$target" 2>/dev/null && removed=1
                c 45 b "done unalias"; cn 10 b "  $target"
            else
                cn 190 b "⚠ '$target' has no alias"; return 1
            fi
            ;;
        f)
            if (( has_func )); then
                unset -f "$target" 2>/dev/null && removed=1
                c 45 b "done unfunction"; cn 10 b "  $target"
            else
                cn 190 b "⚠ '$target' has no function"; return 1
            fi
            ;;
        af)
            if (( has_alias )); then
                unalias "$target" 2>/dev/null && removed=1
                c 45 b "done unalias"; cn 10 b "  $target"
            fi
            if (( has_func )); then
                unset -f "$target" 2>/dev/null && removed=1
                c 45 b "done unfunction"; cn 10 b "  $target"
            fi
            (( removed )) || { c 198 b "⚠ '$target' is not an alias/function"; return 1; }
            ;;
        *)
            # default: ลบตัวที่เจอตัวแรก
            if (( has_alias )); then
                unalias "$target" 2>/dev/null && removed=1
                c 45 b "done unalias"; cn 10 b "  $target"
            elif (( has_func )); then
                unset -f "$target" 2>/dev/null && removed=1
                c 45 b "done unfunction"; cn 10 b "  $target"
            else
                c 198 b "⚠ '$target' is not an alias/function"; return 1
            fi
            ;;
    esac
}
#-- helper for source in subforder
guard() {
    local target
    local loaded_count=0

    for target in "$@"; do
        # 1. ถ้าเป็นโฟลเดอร์ ให้ค้นหาไฟล์ *.sh ในโฟลเดอร์ย่อยทั้งหมด (Recursive)
        if [ -d "$target" ]; then
            while IFS= read -r file; do
                if [ -f "$file" ]; then
                    source "$file"
                    ((loaded_count++))
                fi
            done < <(find "$target" -type f -name "*.sh" 2>/dev/null | sort)

        # 2. ถ้าเป็นไฟล์ธรรมดา ให้ source ได้เลย
        elif [ -f "$target" ]; then
            source "$target"
            ((loaded_count++))
        fi
    done

    # 3. ถ้าหาไฟล์ไม่เจอเลยทั้งในโฟลเดอร์และไฟล์ที่ระบุ ให้แจ้งเตือน
    if [ "$loaded_count" -eq 0 ]; then
        echo -e "\033[33m[WARNING]\033[0m No valid .sh files found to source from: $*" >&2
        return 1
    fi
}
# -- shell switch
sws(){
    local shell_type=$1
    # ── ตั้ง chsh command ตาม environment (array เพื่อรองรับ zsh no-split) ───
    local -a exec_cmd
    if [[ "$JOE_ENV" == "WSL" ]]; then
        exec_cmd=(sudo chsh)
    else
        exec_cmd=(chsh)   # Termux / native Linux ไม่ต้อง sudo
    fi

    # ── helper: หา path ของ shell ──────────────────────────────
    _find_shell(){
        local sh="$1"
        local p; p="$(command -v "$sh" 2>/dev/null)"
        [[ -z "$p" ]] && { cn red b "$sh not found"; return 1; }
        echo "$p"
    }

    # ── helper: switch ทั้ง login-shell + instant session ───────
    _do_switch(){
        local target_shell="$1"
        local target_cmd; target_cmd="$(_find_shell "$target_shell")" || return 1

        # 1) เปลี่ยน login shell (มีผลรอบหน้า)
        "${exec_cmd[@]}" -s "$target_cmd" || { cn red b "chsh failed"; return 1; }

        # 2) อัปเดต $_SHELL ใน env ทันที
        export _SHELL="$target_shell"
        export SHELL="$target_cmd"

        cn 10 b "switched to $target_shell"
        cn 226 b "↳ reloading session now..."

        # 3) Instant switch — แทนที่ process ปัจจุบันด้วย shell ใหม่
        exec "$target_cmd" -l
    }

    # ── No-arg: interactive toggle ──────────────────────────────
    if [[ "$#" -eq 0 ]]; then
        c 198 "b" "SHELL : "; cn ora b "$_SHELL"
        local target_shell confirm

        if [[ "$_SHELL" == "bash" ]]; then
            read -p "$(_ep "SWITCH TO ZSH  (y/n): ")" confirm
            target_shell="zsh"
        elif [[ "$_SHELL" == "zsh" ]]; then
            read "confirm?$(_ep "SWITCH TO BASH (y/n): ")"
            target_shell="bash"
        else
            cn red b "Unknown shell: $_SHELL"; return 1
        fi

        [[ "$confirm" =~ ^[Yy]$ ]] && _do_switch "$target_shell"
        return
    fi

    # ── Direct arg: sws b / sws z ──────────────────────────────
    case $shell_type in
        b|bash) _do_switch bash ;;
        z|zsh)  _do_switch zsh  ;;
        *)      cn red b "Usage: sws [b|bash|z|zsh]" ;;
    esac
}
# -- shell detection
cshell() {
    local active_shell="${_SHELL:-}"
    if [[ -z "$active_shell" ]]; then
        if [[ -n "${ZSH_VERSION:-}" ]]; then
            active_shell="zsh"
        else
            active_shell="bash"
        fi
    fi

    if [[ "$#" -eq 0 ]]; then
        cn ora b "$active_shell"
        return 0
    fi

    local mode="${1:-}"
    local zsh_cmd="${2:-}"
    local bash_cmd="${3:-}"

    case "$mode" in
        -d|--detect)
            if [[ "$active_shell" == "zsh" ]]; then
                eval "$zsh_cmd"
            else    
                eval "$bash_cmd"
            fi
            ;;
    esac
}

