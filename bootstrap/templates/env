#!/bin/bash
# ============================================================
# ~/.local/bin/env — Global Environment & Profile Manager
# ============================================================
# This file is SOURCED by .bashrc/.zshrc (not executed).
# It provides:
#   - PATH setup (~/.local/bin)
#   - Load ~/.env (secrets & overrides)
#   - shell_setup() — symlink shell profiles
#   - repo() — switch between ~/bashscripts and ~/ssot
#
# Generated by bootstrap/install.sh — DO NOT EDIT MANUALLY.
# Re-run bootstrap to regenerate.
# ============================================================

# ── 1. PATH: Add ~/.local/bin if not already present ──
case ":${PATH}:" in
    *:"$HOME/.local/bin":*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# ── 2. Load private env vars (JOE_ENV, SSOT, secrets) ──
[ -f ~/.env ] && . ~/.env

# Git Bash Guard: Force JOE_ENV only — MY_DEVICE stays as set in ~/.env
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        export JOE_ENV="GIT-BASH"
        ;;
esac

# ── 3. SSOT auto-detection (if not set in ~/.env) ──
# Priority: bashscripts (a/personal) > ssot (b/shared)
# To override: set SSOT in ~/.env or use 'repo a/b' at runtime
if [[ -z "${SSOT:-}" ]]; then
    if [[ -d "$HOME/bashscripts" ]]; then
        export SSOT="$HOME/bashscripts"
    elif [[ -d "$HOME/ssot" ]]; then
        export SSOT="$HOME/ssot"
    fi
fi

# ============================================================
# shell_setup() — Symlink shell profiles from $SSOT/profiles/
# ============================================================
# Usage: shell_setup [ENV_NAME]
#   ENV_NAME: TERMUX, MUMU, WSL, GIT-BASH, ACODEX, OPPO
#   If omitted, uses $MY_DEVICE or $JOE_ENV
# ============================================================

