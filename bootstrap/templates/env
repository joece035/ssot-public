#!/bin/bash
# ============================================================
# ~/.local/bin/env — Global Environment & Profile Manager
# ============================================================
# This file is SOURCED by .bashrc/.zshrc (not executed).
# It provides:
#   - PATH setup (~/.local/bin)
#   - Load ~/.env (secrets & overrides)
#   - shell_setup() — symlink shell profiles
#   - repo() — switch between ~/bashscripts and ~/ssot
#
# Generated by bootstrap/install.sh — DO NOT EDIT MANUALLY.
# Re-run bootstrap to regenerate.
# ============================================================

# ── 1. PATH: Add ~/.local/bin if not already present ──
case ":${PATH}:" in
    *:"$HOME/.local/bin":*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# ── 2. Load private env vars (JOE_ENV, SSOT, secrets) ──
[ -f ~/.env ] && . ~/.env

# ── 3. SSOT auto-detection (if not set in ~/.env) ──
if [[ -z "${SSOT:-}" ]]; then
    if [[ -d "$HOME/ssot" ]]; then
        export SSOT="$HOME/ssot"
    elif [[ -d "$HOME/bashscripts" ]]; then
        export SSOT="$HOME/bashscripts"
    fi
fi

# ============================================================
# shell_setup() — Symlink shell profiles from $SSOT/profiles/
# ============================================================
# Usage: shell_setup [ENV_NAME]
#   ENV_NAME: TERMUX, MUMU, WSL, GIT-BASH, ACODEX, OPPO
#   If omitted, uses $JOE_ENV
# ============================================================
shell_setup() {
    local env_="${1:-${JOE_ENV:-}}"
    [[ -z "$env_" ]] && { echo "shell_setup: no environment specified"; return 1; }

    local profile_dir="${SSOT}/profiles/$(echo "$env_" | tr '[:upper:]' '[:lower:]')"
    local shell_rc=""
    local bash_rc=""

    # Determine which shell RC files to create
    case "$env_" in
        TERMUX|MUMU|OPPO)
            # Android: both zsh and bash
            shell_rc="$HOME/.zshrc"
            bash_rc="$HOME/.bashrc"
            ;;
        WSL|GIT-BASH|ACODEX)
            # Desktop: bash only (or default shell)
            shell_rc="$HOME/.bashrc"
            bash_rc="$HOME/.bashrc"
            ;;
        *)
            echo "shell_setup: unknown environment '$env_'"
            return 1
            ;;
    esac

    # Helper: create symlink if source exists
    _link() {
        local target="$1" src="$2"
        [[ ! -f "$src" ]] && { echo "  ⚠️  $src not found — skipping"; return 0; }
        if [[ -L "$target" ]]; then
            local curr
            curr="$(readlink "$target" 2>/dev/null)"
            if [[ "$curr" == "$src" ]]; then
                echo "  ✅ $target already linked"
                return 0
            fi
            rm -f "$target"
        elif [[ -f "$target" ]]; then
            local bak="${target}.bak.$(date +%s)"
            cp "$target" "$bak"
            echo "  📦 Backed up $target → $bak"
            rm -f "$target"
        fi
        ln -sf "$src" "$target"
        echo "  🔗 $target → $src"
    }

    echo "🔗 Wiring shell profiles for $env_..."
    _link "$shell_rc" "$profile_dir/$(basename "$shell_rc")"
    if [[ "$shell_rc" != "$bash_rc" ]]; then
        _link "$bash_rc" "$profile_dir/.bashrc"
    fi
}

# ============================================================
# repo() — Switch between SSOT repositories
# ============================================================
# Usage:
#   repo      — show current repo status
#   repo a    — switch to ~/bashscripts (personal)
#   repo b    — switch to ~/ssot (shared)
#   repo list — show available repos
# ============================================================
repo() {
    local rp1="${HOME}/bashscripts"  # repo a (personal)
    local rp2="${HOME}/ssot"         # repo b (shared)
    local rp="${1:-}"
    local repository=""

    # No argument: show status
    if [[ -z "$rp" ]]; then
        repo_status
        return $?
    fi

    case "$rp" in
        a)      repository="$rp1" ;;
        b)      repository="$rp2" ;;
        list)   repo_list; return 0 ;;
        status) repo_status; return 0 ;;
        *)
            # Check if it's a path
            if [[ -d "$rp" ]]; then
                repository="$rp"
            else
                echo "Usage: repo [a|b|list|status|/path/to/repo]"
                echo "  a     → ~/bashscripts (personal)"
                echo "  b     → ~/ssot (shared)"
                echo "  list  → show available repos"
                echo "  (none) → show current status"
                return 1
            fi
            ;;
    esac

    # Validate repo exists
    if [[ ! -d "$repository" ]]; then
        echo "❌ Repository not found: $repository"
        return 1
    fi

    # Check if joe.sh exists in target
    if [[ ! -f "$repository/joe.sh" ]]; then
        echo "⚠️  Warning: $repository/joe.sh not found"
        echo "   Switching anyway, but joe.sh won't be sourced"
    fi

    # Persist to ~/.env
    if grep -q "^export SSOT=" "$HOME/.env" 2>/dev/null; then
        sed -i "s|^export SSOT=.*|export SSOT=$repository|" "$HOME/.env"
    else
        echo "export SSOT=$repository" >> "$HOME/.env"
    fi

    # Update current session
    export SSOT="$repository"

    # Re-wire shell profiles
    if [[ -L "$HOME/.bashrc" || -L "$HOME/.zshrc" ]]; then
        rm -f "$HOME/.bashrc" "$HOME/.zshrc" 2>/dev/null
        echo "🗑️  Removed old symlinks"
    fi
    shell_setup "${JOE_ENV:-}"

    # Source joe.sh from new repo if it exists
    if [[ -f "$repository/joe.sh" ]]; then
        source "$repository/joe.sh" 2>/dev/null
        echo "✅ Loaded joe.sh from $repository"
    fi

    echo ""
    echo "═══════════════════════════════════════════"
    echo "  ✅ Switched to: $repository"
    echo "═══════════════════════════════════════════"
}

# ── repo helpers ──
repo_status() {
    echo "═══════════════════════════════════════════"
    echo "  📁 Current SSOT: ${SSOT:-<not set>}"
    echo "  🌍 Environment:  ${JOE_ENV:-<not set>}"
    echo "═══════════════════════════════════════════"
    echo ""
    echo "  Available repos:"
    [[ -d "$HOME/bashscripts" ]] && echo "    a) ~/bashscripts (personal) ✅" || echo "    a) ~/bashscripts (personal) ❌ not found"
    [[ -d "$HOME/ssot" ]]        && echo "    b) ~/ssot (shared)          ✅" || echo "    b) ~/ssot (shared)          ❌ not found"
    echo ""
    echo "  Usage: repo [a|b|list]"
}

repo_list() {
    echo "Available repositories:"
    echo ""
    echo "  a) ~/bashscripts — Personal scripts"
    [[ -d "$HOME/bashscripts" ]] && echo "     Status: ✅ exists" || echo "     Status: ❌ not found"
    echo ""
    echo "  b) ~/ssot — Shared scripts (SSOT)"
    [[ -d "$HOME/ssot" ]] && echo "     Status: ✅ exists" || echo "     Status: ❌ not found"
}

# ── Auto-source joe.sh if SSOT is set ──
if [[ -n "${SSOT:-}" && -f "${SSOT}/joe.sh" ]]; then
    source "${SSOT}/joe.sh" 2>/dev/null
fi
