                        ln -sf "$pf" "$HOME/.bashrc" && echo "ลบและสร้าง symlink $pf >>> $HOME/.bashrc done" || echo "FAIL"    
                    fi
                    if [[ ! -f "$HOME/.zshrc" ]]; then
