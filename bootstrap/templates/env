# ============================================================
# repo() — Switch between SSOT repositories
# ============================================================
# Usage:
#   repo      — show ecosystem dashboard & status
#   repo a    — switch to ~/bashscripts (personal)
#   repo b    — switch to ~/ssot (shared)
#   repo list — show available repos
# ============================================================
repo() {
    local rp1="${HOME}/bashscripts"  # repo a (personal)
    local rp2="${HOME}/ssot"         # repo b (shared)
    local rp="${1:-}"
    local repository=""

    # No argument: show dashboard status
    if [[ -z "$rp" ]]; then
        repo_status
        return $?
    fi

    case "$rp" in
        a)      repository="$rp1" ;;
        b)      repository="$rp2" ;;
        list)   repo_list; return 0 ;;
        status) repo_status; return 0 ;;
        *)
            if [[ -d "$rp" ]]; then
                repository="$rp"
            else
                echo "Usage: repo [a|b|list|status|/path/to/repo]"
                echo "  a      → ~/bashscripts (personal)"
                echo "  b      → ~/ssot (shared)"
                echo "  list   → show available repos"
                echo "  status → show ecosystem dashboard"
                return 1
            fi
            ;;
    esac

    # Validate repo exists
    if [[ ! -d "$repository" ]]; then
        echo "❌ Repository not found: $repository"
        return 1
    fi

    echo "🔄 Switching SSOT to: $repository"

    # ── [Stage 1] Clean State ──
    echo "🧹 Cleaning previous installation state..."
    local _bin="$HOME/.local/bin"
    mkdir -p "$_bin"

    # Helper: rm -f then ln -sf (handles MSYS Git Bash where ln -sf cannot replace regular files)
    _safe_link() {
        local _src="$1" _tgt="$2"
        rm -f "$_tgt"
        ln -sf "$_src" "$_tgt"
    }

    # 1. Clean previous tool symlinks/files in ~/.local/bin/
    for _tool in joe syncctl node-status; do
        [[ -L "$_bin/$_tool" || -f "$_bin/$_tool" ]] && rm -f "$_bin/$_tool"
    done

    # 2. Clean shell profile symlinks AND regular files (MSYS compat)
    for _rc in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.bash_aliases"; do
        [[ -L "$_rc" || -f "$_rc" ]] && rm -f "$_rc"
    done

    # 3. Clean broken symlinks in ~/.local/bin and $HOME
    for _dir in "$_bin" "$HOME"; do
        while IFS= read -r -d '' _link_file; do
            [[ ! -e "$_link_file" ]] && rm -f "$_link_file"
        done < <(find "$_dir" -maxdepth 1 -type l -print0 2>/dev/null)
    done

    # ── [Stage 2] Update Environment & SSOT variable ──
    if grep -q "^export SSOT=" "$HOME/.env" 2>/dev/null; then
        sed -i "s|^export SSOT=.*|export SSOT=$repository|" "$HOME/.env"
    else
        echo "export SSOT=$repository" >> "$HOME/.env"
    fi
    export SSOT="$repository"

    # Ensure $SSOT/.env points to ~/.env
    if [[ -f "$HOME/.env" ]]; then
        [[ -f "$repository/.env" && ! -L "$repository/.env" ]] && mv "$repository/.env" "$repository/.env.bak.$(date +%s)"
        ln -sf "$HOME/.env" "$repository/.env"
        echo "🔗 $repository/.env → ~/.env"
    fi

    # ── [Stage 3] Wire Shell Profiles ──
    shell_setup "${2:-${JOE_ENV:-$MY_DEVICE}}"

    # ── [Stage 4] Re-create Tool Symlinks (use _safe_link: rm -f + ln -sf for MSYS compat) ──
    # joe
    if [[ -f "$repository/joe.sh" ]]; then
        _safe_link "$repository/joe.sh" "$_bin/joe"
        chmod +x "$_bin/joe"
        echo "🔗 $_bin/joe → $repository/joe.sh"
    fi

    # syncctl
    if [[ -f "$repository/tools/syncctl/syncctl" ]]; then
        _safe_link "$repository/tools/syncctl/syncctl" "$_bin/syncctl"
        chmod +x "$_bin/syncctl"
        echo "🔗 $_bin/syncctl → $repository/tools/syncctl/syncctl"
    fi

    # node-status
    if [[ -f "$repository/bootstrap/nodes/node-status.sh" ]]; then
        _safe_link "$repository/bootstrap/nodes/node-status.sh" "$_bin/node-status"
        chmod +x "$_bin/node-status"
        echo "🔗 $_bin/node-status → $repository/bootstrap/nodes/node-status.sh"
    fi

    # env manager template update
    if [[ -f "$repository/bootstrap/templates/env" ]]; then
        if [[ -L "$_bin/env" || -f "$_bin/env" ]]; then
            rm -f "$_bin/env" && echo "remove old $_bin/env"
        fi
        _safe_link "$repository/bootstrap/templates/env" "$_bin/env"
        chmod +x "$_bin/env" && echo "create $_bin/env"
        echo "🔗 $_bin/env → $repository/bootstrap/templates/env"
    fi

    # ── [Stage 5] Source joe.sh from target repo ──
    if [[ -f "$repository/joe.sh" ]]; then
        source "$repository/joe.sh" 2>/dev/null
        echo "✅ Loaded joe.sh from $repository"
    fi

    echo ""
    echo "═══════════════════════════════════════════════════════════"
    echo "  ✅ Successfully switched to: $repository"
    echo "═══════════════════════════════════════════════════════════"

    # ── [Stage 5.5] Shared Files Drift Check ──
    local _sync_tool="$repository/tools/sync_shared.sh"
    if [[ -f "$_sync_tool" && -d "$HOME/bashscripts" && -d "$HOME/ssot" ]]; then
        bash "$_sync_tool" check 2>/dev/null || true
    fi

    # ── [Stage 6] Reload Shell immediately ──
    local _current_shell="${SHELL:-bash}"
    echo "🚀 Reloading shell ($_current_shell) — ready to use..."
    exec "$_current_shell"
}

# ============================================================
# repo_status() — Ecosystem Dashboard & Symlink Health Verifier
# ============================================================
repo_status() {
    local bold="" reset="" green="" yellow="" red="" cyan=""
    if [[ -t 1 ]] && command -v tput >/dev/null 2>&1; then
        bold="$(tput bold 2>/dev/null || true)"
        reset="$(tput sgr0 2>/dev/null || true)"
        green="$(tput setaf 2 2>/dev/null || true)"
        yellow="$(tput setaf 3 2>/dev/null || true)"
        red="$(tput setaf 1 2>/dev/null || true)"
        cyan="$(tput setaf 6 2>/dev/null || true)"
    fi

    echo ""
    echo "${bold}${cyan}╔══════════════════════════════════════════════════════════════════╗${reset}"
    echo "${bold}${cyan}║              🔍 SSOT ECOSYSTEM & REPO DASHBOARD                  ║${reset}"
    echo "${bold}${cyan}╚══════════════════════════════════════════════════════════════════╝${reset}"
    echo ""
    echo "${bold}📌 Core Environment:${reset}"
    echo "   📁 Active SSOT  : ${green}${SSOT:-<not set>}${reset}"
    echo "   🌍 JOE_ENV      : ${green}${JOE_ENV:-<not set>}${reset}"
    echo "   📱 MY_DEVICE    : ${green}${MY_DEVICE:-<not set>}${reset}"
    echo "   🐚 Current Shell : ${SHELL:-$0}"
    echo ""
    echo "${bold}📂 Repository Status:${reset}"
    local bsc_status="❌ not found"
    local ssot_status="❌ not found"
    if [[ -d "$HOME/bashscripts" ]]; then
        if [[ "${SSOT:-}" == "$HOME/bashscripts" ]]; then
            bsc_status="${green}✅ ACTIVE${reset}"
        else
            bsc_status="${yellow}⚪ available${reset}"
        fi
    fi
    if [[ -d "$HOME/ssot" ]]; then
        if [[ "${SSOT:-}" == "$HOME/ssot" ]]; then
            ssot_status="${green}✅ ACTIVE${reset}"
        else
            ssot_status="${yellow}⚪ available${reset}"
        fi
    fi
    echo "   a) ~/bashscripts (personal) : $bsc_status"
    echo "   b) ~/ssot        (shared)   : $ssot_status"
    echo ""
    echo "${bold}🔗 Symlink Integrity & Health Check:${reset}"

    _check_link() {
        local name="$1"
        local path="$2"
        local expected_prefix="${3:-}"

        if [[ -L "$path" ]]; then
            local tgt
            tgt="$(readlink "$path" 2>/dev/null)"
            if [[ ! -e "$path" ]]; then
                printf "   ❌ %-18s : ${red}BROKEN LINK${reset} → %s\n" "$name" "$tgt"
            elif [[ -n "$expected_prefix" && "$tgt" != "$expected_prefix"* ]]; then
                printf "   ⚠️  %-18s : ${yellow}MISMATCH LINK${reset} → %s (expected: %s*)\n" "$name" "$tgt" "$expected_prefix"
            else
                printf "   ✅ %-18s : ${green}OK${reset} → %s\n" "$name" "$tgt"
            fi
        elif [[ -e "$path" ]]; then
            printf "   ⚠️  %-18s : ${yellow}REGULAR FILE (not symlinked)${reset}\n" "$name"
        else
            printf "   ❌ %-18s : ${red}MISSING${reset}\n" "$name"
        fi
    }

    # Shell Profiles
    _check_link ".bashrc" "$HOME/.bashrc" "${SSOT:-$HOME/ssot}/profiles"
    _check_link ".zshrc" "$HOME/.zshrc" "${SSOT:-$HOME/ssot}/profiles"

    # Tool Binaries
    _check_link "bin/joe" "$HOME/.local/bin/joe" "${SSOT:-$HOME/ssot}"
    _check_link "bin/syncctl" "$HOME/.local/bin/syncctl" "${SSOT:-$HOME/ssot}"
    _check_link "bin/node-status" "$HOME/.local/bin/node-status" "${SSOT:-$HOME/ssot}"

    # Global env executable
    if [[ -x "$HOME/.local/bin/env" ]]; then
        printf "   ✅ %-18s : ${green}OK (executable)${reset} → %s\n" "bin/env" "$HOME/.local/bin/env"
    elif [[ -f "$HOME/.local/bin/env" ]]; then
        printf "   ⚠️  %-18s : ${yellow}EXISTS BUT NOT EXECUTABLE${reset}\n" "bin/env"
    else
        printf "   ❌ %-18s : ${red}MISSING${reset}\n" "bin/env"
    fi

    # Repo .env Link
    if [[ -n "${SSOT:-}" ]]; then
        _check_link "SSOT/.env" "${SSOT}/.env" "$HOME/.env"
    fi

    # Broken symlinks scan in $HOME and $HOME/.local/bin
    local broken_count=0
    for _d in "$HOME/.local/bin" "$HOME"; do
        while IFS= read -r -d '' _lf; do
            if [[ ! -e "$_lf" ]]; then
                broken_count=$((broken_count + 1))
            fi
        done < <(find "$_d" -maxdepth 1 -type l -print0 2>/dev/null)
    done

    if [[ $broken_count -gt 0 ]]; then
        echo ""
        echo "   ${yellow}⚠️  Found $broken_count broken symlink(s) in ~ or ~/.local/bin (Run 'repo a' or 'repo b' to auto-clean)${reset}"
    fi

    # ── Shared Files Sync Check ──
    local sync_script="${SSOT:-$HOME/ssot}/tools/sync_shared.sh"
    if [[ -f "$sync_script" && -d "$HOME/bashscripts" && -d "$HOME/ssot" ]]; then
        echo ""
        echo "${bold}🔄 Shared Files Sync Status (SSOT ↔ Bashscripts):${reset}"
        if bash "$sync_script" check 2>/dev/null; then
            echo "   ${green}✅ All shared files in sync (.bash_helper, .bash_checker, .zsh-bash-compat.sh)${reset}"
        else
            echo "   ${yellow}⚠️  Shared files out of sync! (Run 'sync-shared' to inspect or sync)${reset}"
        fi
    fi

    # ── Integrated Node Status & Mesh Diagnostics ──
    local node_script="${SSOT:-$HOME/ssot}/bootstrap/nodes/node-status.sh"
    if [[ -f "$node_script" ]]; then
        echo ""
        echo "${bold}🌐 SSOT Mesh & Node Status:${reset}"
        bash "$node_script"
    fi
}

repo_list() {
    echo "Available repositories:"
    echo ""
    echo "  a) ~/bashscripts — Personal scripts"
    [[ -d "$HOME/bashscripts" ]] && echo "     Status: ✅ exists" || echo "     Status: ❌ not found"
    echo ""
    echo "  b) ~/ssot — Shared scripts (SSOT)"
    [[ -d "$HOME/ssot" ]] && echo "     Status: ✅ exists" || echo "     Status: ❌ not found"
}

# ── Auto-source joe.sh if SSOT is set ──
if [[ -n "${SSOT:-}" && -f "${SSOT}/joe.sh" ]]; then
    source "${SSOT}/joe.sh" 2>/dev/null
fi
